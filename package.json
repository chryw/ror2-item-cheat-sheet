{
  "name": "ror2-item-cheat-sheet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "design:generate": "node scripts/design-generate.cjs",
    "design:check": "node scripts/design-tokens.cjs --check && node scripts/design-preview.cjs --check",
    "design:test": "node --test scripts/design-source.test.cjs scripts/design-tokens.test.cjs scripts/design-preview.test.cjs scripts/design-components.test.cjs scripts/design-content.test.cjs",
    "design:export": "node scripts/design-tokens.cjs --export",
    "design:catalog": "node scripts/design-preview.cjs --catalog",
    "design:preview": "node scripts/design-preview.cjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.28",
    "@fortawesome/free-solid-svg-icons": "^5.13.0",
    "@fortawesome/vue-fontawesome": "^0.1.9",
    "core-js": "^3.6.4",
    "vue": "^2.6.11",
    "vue-multiselect": "^2.1.6",
    "vuex": "^3.3.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~4.3.0",
    "@vue/cli-plugin-eslint": "^4.3.1",
    "@vue/cli-service": "~4.3.0",
    "@vue/eslint-config-airbnb": "^5.0.2",
    "babel-eslint": "^10.1.0",
    "eslint": "^6.7.2",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-vue": "^6.2.2",
    "js-yaml": "^4.1.1",
    "mini-css-extract-plugin": "^0.9.0",
    "vue-template-compiler": "^2.6.11"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended",
      "@vue/eslint-config-airbnb"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "overrides": [
      {
        "files": ["scripts/design-source.cjs"],
        "rules": {
          "import/no-extraneous-dependencies": ["error", { "devDependencies": true }]
        }
      },
      {
        "files": ["scripts/design-preview.js", "scripts/*.mjs"],
        "rules": {
          "import/extensions": ["error", "ignorePackages", { "mjs": "always" }],
          "no-use-before-define": ["error", { "functions": false }]
        }
      }
    ],
    "rules": {
      "comma-dangle": "warn",
      "linebreak-style": "off",
      "no-trailing-spaces": "off",
      "quotes": "off",
      "no-unused-vars": "warn",
      "no-plusplus": "off",
      "arrow-parens": "off",
      "object-curly-newline": "off",
      "arrow-body-style": "off",
      "max-len": "warn",
      "space-before-function-paren": "warn"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
